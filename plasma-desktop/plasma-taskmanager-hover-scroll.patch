+            to: "ShowRight"
+            NumberAnimation {
+                target: root.textItem
+                properties: "x"
+                easing.type: Easing.Linear
+                duration: Math.abs(root.revealOffset) * root.forwardMsPerPixel
+            }
+        },
+        Transition {
+            from: "ShowRight"
+            to: ""
+            enabled: root.animatedReturn
+            NumberAnimation {
+                target: root.textItem
+                properties: "x"
+                easing.type: Easing.Linear
