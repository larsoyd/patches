+    Timer {
+        id: returnCompleteTimer
+        interval: Math.min(root.maxReturnDuration, Math.max(root.minReturnDuration,
+            Math.abs(root.revealOffset) * root.returnMsPerPixel))
+        running: root.state === "" && root.pendingRearm
+        repeat: false
+        onTriggered: {
+            root.pendingRearm = false;
+            if (root.hovered) {
+                startTimer.restart();
+            }
+        }
+    }
