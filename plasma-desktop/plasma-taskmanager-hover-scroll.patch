+            // continuously-evaluated `hovered` property: a caller
+            // combining hovered with a layout-derived condition like
+            // "lineCount === 1" risks that condition flickering mid-
+            // animation (elide/width changes during the reveal can jitter
+            // layout-derived properties), which would force repeated
+            // cancel-and-restart cycles and look like the text bouncing.
+            if (root.width < root.textItem.implicitWidth && root.textItem.lineCount === 1) {
+                root.revealOffset = root.width - root.textItem.implicitWidth;
                 root.state = "ShowRight";
             }
         }
     }
 
+    Timer {
+        id: endTimer
+        interval: root.endDelay
+        repeat: false
+        onTriggered: {
+            if (root.state === "ShowRight" && root.hovered) {
+                root.state = "";
+            }
+        }
+    }
+
+    // Fires exactly when the forward reveal animation is expected to
+    // finish (same duration formula, started at the same instant the
+    // "ShowRight" state is entered). A direct onFinished handler on the
+    // Transition's NumberAnimation was tried instead of this and proved
+    // unreliable in practice (it did not consistently fire), so this
