+    // changes, so this collapses to the original `state === "ShowRight"`
+    // behavior exactly - no observable change for that (e.g. MPRIS) path.
+    readonly property bool revealActive:
+        state === "ShowRight" || (animatedReturn && textItem.x !== 0)
+
+    function resetForContentChange() {
+        if (root.state !== "") {
+            root.state = "";
+            root.pendingRearm = root.hovered;
+        } else if (root.hovered) {
