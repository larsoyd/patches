-        // use State to avoid unnecessary re-evaluation when the label is invisible
-        states: State {
-            name: "labelVisible"
-            when: label.visible
-
-            PropertyChanges {
-                label.text: task.model.display
+        // Kept as a pure, stable hover signal - see the lineCount check
+        // inside ScrollableTextWrapper's startTimer for why the
+        // single-line gating isn't folded in here.
+        hovered: task.containsMouse
+        // task.containsMouse (above) already provides hover; disables this
+        // wrapper's own MouseArea input/hover handling entirely so it
+        // cannot interfere with task's own ToolTipArea hover state (which
+        // drives the window preview popup).
+        selfDetectHover: false
+        startDelay: 300
+        endDelay: 500
+        autoReturn: true
+        animatedReturn: true
+        resetOnContentChange: true
+
+        textItem: PlasmaComponents3.Label {
+            id: label
+
+            // ScrollableTextWrapper only binds textItem.width, not height
+            // (a caller-imposed height would fight PlayerController's own
+            // Layout.preferredHeight: songText.height, which derives the
+            // *wrapper's* height from the label instead). Task.qml needs
+            // the reverse relationship - the label filling the task
+            // button's fixed title-row height, exactly as it did before
+            // this wrap (previously via anchors.fill: parent) - so that
+            // relationship is restored here instead of in the shared
+            // component. Without it, Text.ElideRight + Text.Wrap (the
+            // default maxTextLines: 0 config) has no height to elide
+            // against and can wrap across multiple lines instead of
+            // eliding, which also permanently blocks scrolling since
+            // ScrollableTextWrapper requires lineCount === 1.
+            height: labelScroller.height
+
+            // Forced to NoWrap for as long as revealActive is true,
+            // regardless of maxTextLines config: with elide switched to
+            // ElideNone during the reveal/return, the full (longer)
+            // unelided string needs more horizontal space than fits at the
+            // task's width - if wrapMode stayed Text.Wrap, Qt lays that
+            // full string out across multiple lines instead of one long
+            // line extending past the clipping viewport (confirmed
+            // directly: lineCount jumps from 1 to 5 with ElideNone+Wrap on
+            // representative long text), which then renders as a garbled,
+            // vertically-centered multi-line fragment clipped by
+            // labelScroller's fixed height. NoWrap is exactly what makes
+            // the "long single line clipped by a fixed-width viewport"
+            // scrolling model actually hold.
+            wrapMode: labelScroller.revealActive
+                ? Text.NoWrap
+                : ((label.maximumLineCount === 1) ? Text.NoWrap : Text.Wrap)
+            // ScrollableTextWrapper clips/keeps the full string rendered
+            // for as long as revealActive is true, which (with
+            // animatedReturn: true here) spans the whole return animation
+            // too, not just state === "ShowRight" - matching that instead
+            // of the raw state avoids briefly re-eliding and unclipping
+            // the label while it is still animating back from a negative x.
+            elide: labelScroller.revealActive ? Text.ElideNone : Text.ElideRight
+            textFormat: Text.PlainText
+            verticalAlignment: Text.AlignVCenter
+            maximumLineCount: Plasmoid.configuration.maxTextLines || undefined
+
+            // The accessible item of this element is only used for debugging
+            // purposes, and it will never gain focus (thus it won't interfere
+            // with screenreaders).
+            Accessible.ignored: !labelScroller.visible
+            Accessible.name: labelScroller.parent.Accessible.name + "-labelhint"
+
+            // use State to avoid unnecessary re-evaluation when the label is invisible
+            states: State {
+                name: "labelVisible"
+                when: labelScroller.visible
+
+                PropertyChanges {
+                    label.text: task.model.display
+                }
             }
         }
     }
