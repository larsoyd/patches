+    // and starts at the exact same instant as the real animation - is used
+    // instead. Any genuine interruption (leave, content/width change)
+    // changes root.state away from "ShowRight" before this fires, and the
+    // onTriggered guard below no-ops in that case.
+    Timer {
+        id: forwardCompleteTimer
+        interval: Math.abs(root.revealOffset) * root.forwardMsPerPixel
+        running: root.state === "ShowRight" && root.autoReturn
+        repeat: false
+        onTriggered: {
+            if (root.state === "ShowRight" && root.hovered) {
+                endTimer.restart();
+            }
+        }
+    }
