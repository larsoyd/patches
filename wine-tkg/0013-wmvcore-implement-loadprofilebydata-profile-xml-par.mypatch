+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
+ *
+ * This library is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
+ * Lesser General Public License for more details.
+ *
+ * You should have received a copy of the GNU Lesser General Public
+ * License along with this library; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin St, Fifth Floor, Boston, MA 02110-1301, USA
+ */
+
+#include <stdarg.h>
+#include <stddef.h>
+#include <stdbool.h>
+#include <stdlib.h>
+#include <string.h>
+#include <wchar.h>
+
+#define COBJMACROS
+#include "windef.h"
+#include "winbase.h"
+#include "wingdi.h"
+#include "objbase.h"
+#include "mmreg.h"
+#include "strmif.h"
+#include "amvideo.h"
+
+#include "wmvcore_private.h"
+#include "wmsdk.h"
+
+/* Pulled in after wmsdk.h (and without INITGUID active while wmsdk.h is processed) so that
+ * wmsdkidl.h's DEFINE_GUID(IID_IWMProfile3, ...) etc. stay plain extern declarations here --
+ * async_reader.c is already the one file in this DLL that defines those. IID_IXmlReader is
+ * not defined anywhere else in wmvcore, so this is the one file that owns its definition. */
+#include "initguid.h"
+#include "xmllite.h"
+
+#include "wine/debug.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(wmvcore);
+
+/* Format-type GUIDs. Not present in the profile-XML data itself -- implied by which child
+ * element (waveformatex vs videoinfoheader) appears -- so defined locally instead of pulling
+ * in the whole INITGUID-guarded uuids.h just for two well-known constants. */
+static const GUID wm_FORMAT_WaveFormatEx =
+    {0x05589f81, 0xc356, 0x11ce, {0xbf, 0x01, 0x00, 0xaa, 0x00, 0x55, 0x59, 0x5a}};
+static const GUID wm_FORMAT_VideoInfo =
+    {0x05589f80, 0xc356, 0x11ce, {0xbf, 0x01, 0x00, 0xaa, 0x00, 0x55, 0x59, 0x5a}};
+
+struct wm_profile_stream
+{
+    IWMStreamConfig IWMStreamConfig_iface;
+    IWMMediaProps IWMMediaProps_iface;
+    LONG refcount;
+
+    WORD stream_number;
+    GUID major_type;
+    WCHAR *stream_name;
+    WCHAR *connection_name;
+    DWORD bitrate;
+    DWORD buffer_window;
+
+    WM_MEDIA_TYPE mt;   /* mt.pbFormat is owned via CoTaskMemAlloc */
+};
+
+struct wm_profile
+{
+    IWMProfile3 IWMProfile3_iface;
+    LONG refcount;
+
+    WCHAR *name;
+    WCHAR *description;
+    DWORD version;
+    DWORD storage_format;
+
+    struct wm_profile_stream **streams;
+    DWORD stream_count;
+};
+
+/* ------------------------------------------------------------------------------------------
+ * small helpers
+ * ------------------------------------------------------------------------------------------ */
+
+static WCHAR *wm_strdupW(const WCHAR *s)
+{
+    WCHAR *ret;
+    size_t len;
+
+    if (!s)
+        return NULL;
+
+    len = (wcslen(s) + 1) * sizeof(WCHAR);
+    if (!(ret = malloc(len)))
+        return NULL;
+    memcpy(ret, s, len);
+    return ret;
+}
+
+static DWORD wm_parse_dword(const WCHAR *value)
+{
+    return value ? wcstoul(value, NULL, 10) : 0;
+}
+
+static LONGLONG wm_parse_qword(const WCHAR *value)
+{
+    return value ? wcstoll(value, NULL, 10) : 0;
+}
+
+static BOOL wm_parse_bool(const WCHAR *value)
+{
+    return value && wm_parse_dword(value) != 0;
+}
+
+static int hex_nibble(WCHAR c)
+{
+    if (c >= '0' && c <= '9') return c - '0';
+    if (c >= 'a' && c <= 'f') return c - 'a' + 10;
+    if (c >= 'A' && c <= 'F') return c - 'A' + 10;
+    return -1;
+}
+
+/* Decodes an even-length hex-digit string (e.g. "008800000F0059550000") into raw bytes.
+ * Returns the byte count via *len_out; NULL/zero-length input yields a zero-length result. */
+static BYTE *wm_decode_hex(const WCHAR *value, DWORD *len_out)
+{
+    size_t char_len = value ? wcslen(value) : 0;
+    DWORD len = char_len / 2;
+    BYTE *buf;
+    DWORD i;
+
+    *len_out = 0;
+    if (!len)
+        return NULL;
+    if (!(buf = malloc(len)))
+        return NULL;
+
+    for (i = 0; i < len; ++i)
+    {
+        int hi = hex_nibble(value[i * 2]);
+        int lo = hex_nibble(value[i * 2 + 1]);
+        if (hi < 0 || lo < 0)
+        {
+            free(buf);
+            *len_out = 0;
+            return NULL;
+        }
+        buf[i] = (BYTE)((hi << 4) | lo);
+    }
+
+    *len_out = len;
+    return buf;
+}
+
+static DWORD wm_fourcc_from_string(const WCHAR *value)
+{
+    BYTE b[4] = {' ', ' ', ' ', ' '};
+    size_t len = value ? wcslen(value) : 0;
+    unsigned int i;
+
+    for (i = 0; i < 4 && i < len; ++i)
+        b[i] = (BYTE)value[i];
+
+    return (DWORD)b[0] | ((DWORD)b[1] << 8) | ((DWORD)b[2] << 16) | ((DWORD)b[3] << 24);
+}
+
+static void wm_media_type_free(WM_MEDIA_TYPE *mt)
+{
+    CoTaskMemFree(mt->pbFormat);
+    memset(mt, 0, sizeof(*mt));
+}
+
+static HRESULT wm_media_type_copy(WM_MEDIA_TYPE *dst, const WM_MEDIA_TYPE *src)
+{
+    BYTE *format = NULL;
+
+    if (src->cbFormat && !(format = CoTaskMemAlloc(src->cbFormat)))
+        return E_OUTOFMEMORY;
+    if (src->cbFormat)
+        memcpy(format, src->pbFormat, src->cbFormat);
+
+    wm_media_type_free(dst);
+    *dst = *src;
+    dst->pbFormat = format;
+    dst->pUnk = NULL;
+    return S_OK;
+}
+
+/* ------------------------------------------------------------------------------------------
+ * IWMStreamConfig / IWMMediaProps  (struct wm_profile_stream)
+ * ------------------------------------------------------------------------------------------ */
+
+static struct wm_profile_stream *impl_from_IWMStreamConfig(IWMStreamConfig *iface)
+{
+    return CONTAINING_RECORD(iface, struct wm_profile_stream, IWMStreamConfig_iface);
+}
+
+static struct wm_profile_stream *impl_from_IWMMediaProps(IWMMediaProps *iface)
+{
+    return CONTAINING_RECORD(iface, struct wm_profile_stream, IWMMediaProps_iface);
+}
+
+static void wm_profile_stream_destroy(struct wm_profile_stream *stream)
+{
+    wm_media_type_free(&stream->mt);
+    free(stream->stream_name);
+    free(stream->connection_name);
+    free(stream);
+}
+
+static HRESULT WINAPI stream_config_QueryInterface(IWMStreamConfig *iface, REFIID iid, void **out)
+{
+    struct wm_profile_stream *stream = impl_from_IWMStreamConfig(iface);
+
+    TRACE("stream %p, iid %s, out %p.\n", stream, debugstr_guid(iid), out);
+
+    if (IsEqualGUID(iid, &IID_IUnknown) || IsEqualGUID(iid, &IID_IWMStreamConfig))
+        *out = &stream->IWMStreamConfig_iface;
+    else if (IsEqualGUID(iid, &IID_IWMMediaProps))
+        *out = &stream->IWMMediaProps_iface;
+    else
+    {
+        *out = NULL;
+        WARN("%s not implemented, returning E_NOINTERFACE.\n", debugstr_guid(iid));
+        return E_NOINTERFACE;
+    }
+
+    IUnknown_AddRef((IUnknown *)*out);
+    return S_OK;
+}
+
+static ULONG WINAPI stream_config_AddRef(IWMStreamConfig *iface)
+{
+    struct wm_profile_stream *stream = impl_from_IWMStreamConfig(iface);
+    ULONG refcount = InterlockedIncrement(&stream->refcount);
+
+    TRACE("%p increasing refcount to %lu.\n", stream, refcount);
+    return refcount;
+}
+
+static ULONG WINAPI stream_config_Release(IWMStreamConfig *iface)
+{
+    struct wm_profile_stream *stream = impl_from_IWMStreamConfig(iface);
+    ULONG refcount = InterlockedDecrement(&stream->refcount);
+
+    TRACE("%p decreasing refcount to %lu.\n", stream, refcount);
+    if (!refcount)
+        wm_profile_stream_destroy(stream);
+    return refcount;
+}
+
+static HRESULT WINAPI stream_config_GetStreamType(IWMStreamConfig *iface, GUID *type)
+{
+    struct wm_profile_stream *stream = impl_from_IWMStreamConfig(iface);
+
+    TRACE("stream %p, type %p.\n", stream, type);
+    *type = stream->major_type;
+    return S_OK;
+}
+
+static HRESULT WINAPI stream_config_GetStreamNumber(IWMStreamConfig *iface, WORD *number)
+{
+    struct wm_profile_stream *stream = impl_from_IWMStreamConfig(iface);
+
+    TRACE("stream %p, number %p.\n", stream, number);
+    *number = stream->stream_number;
+    return S_OK;
+}
+
+static HRESULT WINAPI stream_config_SetStreamNumber(IWMStreamConfig *iface, WORD number)
+{
+    struct wm_profile_stream *stream = impl_from_IWMStreamConfig(iface);
+
+    TRACE("stream %p, number %u.\n", stream, number);
+    stream->stream_number = number;
+    return S_OK;
+}
+
+static HRESULT wm_get_string(const WCHAR *src, WCHAR *out, WORD *len)
+{
+    DWORD required = (src ? (DWORD)wcslen(src) : 0) + 1;
+
+    if (!out || *len < required)
+    {
+        *len = required;
+        return ASF_E_BUFFERTOOSMALL;
+    }
+
+    if (src)
+        memcpy(out, src, required * sizeof(WCHAR));
+    else
+        out[0] = 0;
+    *len = required;
+    return S_OK;
+}
+
+static HRESULT WINAPI stream_config_GetStreamName(IWMStreamConfig *iface, WCHAR *name, WORD *len)
+{
+    struct wm_profile_stream *stream = impl_from_IWMStreamConfig(iface);
+
+    TRACE("stream %p, name %p, len %p.\n", stream, name, len);
+    return wm_get_string(stream->stream_name, name, len);
+}
+
+static HRESULT WINAPI stream_config_SetStreamName(IWMStreamConfig *iface, const WCHAR *name)
+{
+    struct wm_profile_stream *stream = impl_from_IWMStreamConfig(iface);
+    WCHAR *copy;
+
+    TRACE("stream %p, name %s.\n", stream, debugstr_w(name));
+
+    if (name && !(copy = wm_strdupW(name)))
+        return E_OUTOFMEMORY;
+    else if (!name)
+        copy = NULL;
+
+    free(stream->stream_name);
+    stream->stream_name = copy;
+    return S_OK;
+}
+
+static HRESULT WINAPI stream_config_GetConnectionName(IWMStreamConfig *iface, WCHAR *name, WORD *len)
+{
+    struct wm_profile_stream *stream = impl_from_IWMStreamConfig(iface);
+
+    TRACE("stream %p, name %p, len %p.\n", stream, name, len);
+    return wm_get_string(stream->connection_name, name, len);
+}
+
+static HRESULT WINAPI stream_config_SetConnectionName(IWMStreamConfig *iface, const WCHAR *name)
+{
+    struct wm_profile_stream *stream = impl_from_IWMStreamConfig(iface);
+    WCHAR *copy;
+
+    TRACE("stream %p, name %s.\n", stream, debugstr_w(name));
+
+    if (name && !(copy = wm_strdupW(name)))
+        return E_OUTOFMEMORY;
+    else if (!name)
+        copy = NULL;
+
+    free(stream->connection_name);
+    stream->connection_name = copy;
+    return S_OK;
+}
+
+static HRESULT WINAPI stream_config_GetBitrate(IWMStreamConfig *iface, DWORD *bitrate)
+{
+    struct wm_profile_stream *stream = impl_from_IWMStreamConfig(iface);
+
+    TRACE("stream %p, bitrate %p.\n", stream, bitrate);
+    *bitrate = stream->bitrate;
+    return S_OK;
+}
+
+static HRESULT WINAPI stream_config_SetBitrate(IWMStreamConfig *iface, DWORD bitrate)
+{
+    struct wm_profile_stream *stream = impl_from_IWMStreamConfig(iface);
+
+    TRACE("stream %p, bitrate %lu.\n", stream, bitrate);
+    stream->bitrate = bitrate;
+    return S_OK;
+}
+
+static HRESULT WINAPI stream_config_GetBufferWindow(IWMStreamConfig *iface, DWORD *window)
+{
+    struct wm_profile_stream *stream = impl_from_IWMStreamConfig(iface);
+
+    TRACE("stream %p, window %p.\n", stream, window);
+    *window = stream->buffer_window;
+    return S_OK;
+}
+
+static HRESULT WINAPI stream_config_SetBufferWindow(IWMStreamConfig *iface, DWORD window)
+{
+    struct wm_profile_stream *stream = impl_from_IWMStreamConfig(iface);
+
+    TRACE("stream %p, window %lu.\n", stream, window);
+    stream->buffer_window = window;
+    return S_OK;
+}
+
+static const IWMStreamConfigVtbl stream_config_vtbl =
+{
+    stream_config_QueryInterface,
+    stream_config_AddRef,
+    stream_config_Release,
+    stream_config_GetStreamType,
+    stream_config_GetStreamNumber,
+    stream_config_SetStreamNumber,
+    stream_config_GetStreamName,
+    stream_config_SetStreamName,
+    stream_config_GetConnectionName,
+    stream_config_SetConnectionName,
+    stream_config_GetBitrate,
+    stream_config_SetBitrate,
+    stream_config_GetBufferWindow,
+    stream_config_SetBufferWindow,
+};
+
+static HRESULT WINAPI stream_props_QueryInterface(IWMMediaProps *iface, REFIID iid, void **out)
+{
+    struct wm_profile_stream *stream = impl_from_IWMMediaProps(iface);
+    return IWMStreamConfig_QueryInterface(&stream->IWMStreamConfig_iface, iid, out);
+}
+
+static ULONG WINAPI stream_props_AddRef(IWMMediaProps *iface)
+{
+    struct wm_profile_stream *stream = impl_from_IWMMediaProps(iface);
+    return IWMStreamConfig_AddRef(&stream->IWMStreamConfig_iface);
+}
+
+static ULONG WINAPI stream_props_Release(IWMMediaProps *iface)
+{
+    struct wm_profile_stream *stream = impl_from_IWMMediaProps(iface);
+    return IWMStreamConfig_Release(&stream->IWMStreamConfig_iface);
+}
+
+static HRESULT WINAPI stream_props_GetType(IWMMediaProps *iface, GUID *major_type)
+{
+    struct wm_profile_stream *stream = impl_from_IWMMediaProps(iface);
+
+    TRACE("stream %p, major_type %p.\n", stream, major_type);
+    *major_type = stream->major_type;
+    return S_OK;
+}
+
+static HRESULT WINAPI stream_props_GetMediaType(IWMMediaProps *iface, WM_MEDIA_TYPE *mt, DWORD *size)
+{
+    struct wm_profile_stream *stream = impl_from_IWMMediaProps(iface);
+    DWORD required = sizeof(*mt) + stream->mt.cbFormat;
+    DWORD req_size = *size;
+
+    TRACE("stream %p, mt %p, size %p.\n", stream, mt, size);
+
+    *size = required;
+    if (mt && req_size >= required)
+    {
+        memcpy(mt, &stream->mt, sizeof(*mt));
+        if (stream->mt.cbFormat)
+            memcpy(mt + 1, stream->mt.pbFormat, stream->mt.cbFormat);
+        mt->pbFormat = (BYTE *)(mt + 1);
+        mt->pUnk = NULL;
+    }
+    else if (mt)
+        return ASF_E_BUFFERTOOSMALL;
+
+    return S_OK;
+}
+
+static HRESULT WINAPI stream_props_SetMediaType(IWMMediaProps *iface, WM_MEDIA_TYPE *mt)
+{
+    struct wm_profile_stream *stream = impl_from_IWMMediaProps(iface);
+
+    TRACE("stream %p, mt %p.\n", stream, mt);
+
+    if (!mt)
+        return E_INVALIDARG;
+
+    stream->major_type = mt->majortype;
+    return wm_media_type_copy(&stream->mt, mt);
+}
+
+static const IWMMediaPropsVtbl stream_props_vtbl =
+{
+    stream_props_QueryInterface,
+    stream_props_AddRef,
+    stream_props_Release,
+    stream_props_GetType,
+    stream_props_GetMediaType,
+    stream_props_SetMediaType,
+};
+
+/* ------------------------------------------------------------------------------------------
+ * IWMProfile3  (struct wm_profile)
+ * ------------------------------------------------------------------------------------------ */
+
+static struct wm_profile *impl_from_IWMProfile3(IWMProfile3 *iface)
+{
+    return CONTAINING_RECORD(iface, struct wm_profile, IWMProfile3_iface);
+}
+
+static void wm_profile_destroy(struct wm_profile *profile)
+{
+    DWORD i;
+
+    for (i = 0; i < profile->stream_count; ++i)
+        IWMStreamConfig_Release(&profile->streams[i]->IWMStreamConfig_iface);
+    free(profile->streams);
+    free(profile->name);
+    free(profile->description);
+    free(profile);
+}
+
+static HRESULT WINAPI profile_QueryInterface(IWMProfile3 *iface, REFIID iid, void **out)
+{
+    struct wm_profile *profile = impl_from_IWMProfile3(iface);
+
+    TRACE("profile %p, iid %s, out %p.\n", profile, debugstr_guid(iid), out);
+
+    if (IsEqualGUID(iid, &IID_IUnknown) || IsEqualGUID(iid, &IID_IWMProfile)
+            || IsEqualGUID(iid, &IID_IWMProfile2) || IsEqualGUID(iid, &IID_IWMProfile3))
+        *out = &profile->IWMProfile3_iface;
+    else
+    {
+        *out = NULL;
+        WARN("%s not implemented, returning E_NOINTERFACE.\n", debugstr_guid(iid));
+        return E_NOINTERFACE;
+    }
+
+    IUnknown_AddRef((IUnknown *)*out);
+    return S_OK;
+}
+
+static ULONG WINAPI profile_AddRef(IWMProfile3 *iface)
+{
+    struct wm_profile *profile = impl_from_IWMProfile3(iface);
+    ULONG refcount = InterlockedIncrement(&profile->refcount);
+
+    TRACE("%p increasing refcount to %lu.\n", profile, refcount);
+    return refcount;
+}
+
+static ULONG WINAPI profile_Release(IWMProfile3 *iface)
+{
+    struct wm_profile *profile = impl_from_IWMProfile3(iface);
+    ULONG refcount = InterlockedDecrement(&profile->refcount);
+
+    TRACE("%p decreasing refcount to %lu.\n", profile, refcount);
+    if (!refcount)
+        wm_profile_destroy(profile);
+    return refcount;
+}
+
+static HRESULT WINAPI profile_GetVersion(IWMProfile3 *iface, WMT_VERSION *version)
+{
+    struct wm_profile *profile = impl_from_IWMProfile3(iface);
+
+    TRACE("profile %p, version %p.\n", profile, version);
+    *version = profile->version;
+    return S_OK;
+}
+
+static HRESULT WINAPI profile_GetName(IWMProfile3 *iface, WCHAR *name, DWORD *length)
+{
+    struct wm_profile *profile = impl_from_IWMProfile3(iface);
+    DWORD required = (profile->name ? (DWORD)wcslen(profile->name) : 0) + 1;
+
+    TRACE("profile %p, name %p, length %p.\n", profile, name, length);
+
+    if (!name || *length < required)
+    {
+        *length = required;
+        return ASF_E_BUFFERTOOSMALL;
+    }
+    memcpy(name, profile->name ? profile->name : L"", required * sizeof(WCHAR));
+    *length = required;
+    return S_OK;
+}
+
+static HRESULT WINAPI profile_SetName(IWMProfile3 *iface, const WCHAR *name)
+{
+    struct wm_profile *profile = impl_from_IWMProfile3(iface);
+    WCHAR *copy;
+
+    TRACE("profile %p, name %s.\n", profile, debugstr_w(name));
+
+    if (name && !(copy = wm_strdupW(name)))
+        return E_OUTOFMEMORY;
+    else if (!name)
+        copy = NULL;
+
+    free(profile->name);
+    profile->name = copy;
+    return S_OK;
+}
+
+static HRESULT WINAPI profile_GetDescription(IWMProfile3 *iface, WCHAR *description, DWORD *length)
+{
+    struct wm_profile *profile = impl_from_IWMProfile3(iface);
+    DWORD required = (profile->description ? (DWORD)wcslen(profile->description) : 0) + 1;
+
+    TRACE("profile %p, description %p, length %p.\n", profile, description, length);
+
+    if (!description || *length < required)
+    {
+        *length = required;
+        return ASF_E_BUFFERTOOSMALL;
+    }
+    memcpy(description, profile->description ? profile->description : L"", required * sizeof(WCHAR));
+    *length = required;
+    return S_OK;
+}
+
+static HRESULT WINAPI profile_SetDescription(IWMProfile3 *iface, const WCHAR *description)
+{
+    struct wm_profile *profile = impl_from_IWMProfile3(iface);
+    WCHAR *copy;
+
+    TRACE("profile %p, description %s.\n", profile, debugstr_w(description));
+
+    if (description && !(copy = wm_strdupW(description)))
+        return E_OUTOFMEMORY;
+    else if (!description)
+        copy = NULL;
+
+    free(profile->description);
+    profile->description = copy;
+    return S_OK;
+}
+
+static HRESULT WINAPI profile_GetStreamCount(IWMProfile3 *iface, DWORD *count)
+{
+    struct wm_profile *profile = impl_from_IWMProfile3(iface);
+
+    TRACE("profile %p, count %p.\n", profile, count);
+    if (!count)
+        return E_INVALIDARG;
+    *count = profile->stream_count;
+    return S_OK;
+}
+
+static HRESULT WINAPI profile_GetStream(IWMProfile3 *iface, DWORD index, IWMStreamConfig **config)
+{
+    struct wm_profile *profile = impl_from_IWMProfile3(iface);
+
+    TRACE("profile %p, index %lu, config %p.\n", profile, index, config);
+
+    if (index >= profile->stream_count)
+    {
+        WARN("Index %lu exceeds stream count %lu.\n", index, profile->stream_count);
+        return E_INVALIDARG;
+    }
+
+    IWMStreamConfig_AddRef(&profile->streams[index]->IWMStreamConfig_iface);
+    *config = &profile->streams[index]->IWMStreamConfig_iface;
+    return S_OK;
+}
+
+static HRESULT WINAPI profile_GetStreamByNumber(IWMProfile3 *iface, WORD stream_number, IWMStreamConfig **config)
+{
+    struct wm_profile *profile = impl_from_IWMProfile3(iface);
+    DWORD i;
+
+    TRACE("profile %p, stream_number %u, config %p.\n", profile, stream_number, config);
+
+    for (i = 0; i < profile->stream_count; ++i)
+    {
+        if (profile->streams[i]->stream_number == stream_number)
+        {
+            IWMStreamConfig_AddRef(&profile->streams[i]->IWMStreamConfig_iface);
+            *config = &profile->streams[i]->IWMStreamConfig_iface;
+            return S_OK;
+        }
+    }
+
+    return NS_E_NO_STREAM;
+}
