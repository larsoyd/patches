+    profile_SetStreamPrioritization,
+    profile_RemoveStreamPrioritization,
+    profile_CreateNewStreamPrioritization,
+    profile_GetExpectedPacketCount,
+};
+
+/* ------------------------------------------------------------------------------------------
+ * profile-XML parsing
+ *
+ * Schema is a small closed set (confirmed by extracting and inspecting all 31 RT_PRX
+ * resources Windows Movie Maker 6.0 embeds in MOVIEMK.dll): <profile>, <streamconfig>,
+ * <wmmediatype>, <waveformatex>, <videomediaprops>, <videoinfoheader>, <rcsource>,
+ * <rctarget>, <bitmapinfoheader>, <dataunitextension>, <streamprioritization>, <stream>.
+ * All are flat attribute bags, nested at most 4 levels deep -- a small explicit context
+ * stack plus a scratch struct for the in-progress video format is enough; no general
+ * tree/DOM is needed.
+ * ------------------------------------------------------------------------------------------ */
+
+enum profile_ctx
+{
+    CTX_ROOT,
+    CTX_PROFILE,
+    CTX_STREAMCONFIG,
+    CTX_WMMEDIATYPE,
+    CTX_VIDEOINFOHEADER,
+    CTX_OTHER,          /* includes waveformatex/rcsource/rctarget/bitmapinfoheader/
+                          * videomediaprops/dataunitextension/streamprioritization/stream --
+                          * all handled entirely within handle_element_start(), nothing to
+                          * do when they close */
+};
+
+struct parse_ctx
+{
+    struct wm_profile *profile;
+    struct wm_profile_stream *cur_stream;   /* stream currently being parsed, or NULL */
+
+    /* scratch state while building the current stream's video format */
+    RECT rc_source, rc_target;
+    BITMAPINFOHEADER bmih;
+    DWORD vih_bitrate, vih_biterrorrate;
+    LONGLONG vih_avgtimeperframe;
+
+    enum profile_ctx stack[32];
+    int depth;
+};
+
+static HRESULT wm_profile_stream_create(struct wm_profile_stream **out)
+{
+    struct wm_profile_stream *stream;
+
+    if (!(stream = calloc(1, sizeof(*stream))))
+        return E_OUTOFMEMORY;
+    stream->IWMStreamConfig_iface.lpVtbl = &stream_config_vtbl;
+    stream->IWMMediaProps_iface.lpVtbl = &stream_props_vtbl;
+    stream->refcount = 1;
+    stream->buffer_window = -1;
+    *out = stream;
+    return S_OK;
+}
+
+static HRESULT wm_profile_add_stream(struct wm_profile *profile, struct wm_profile_stream *stream)
+{
+    struct wm_profile_stream **streams;
+
+    if (!(streams = realloc(profile->streams, (profile->stream_count + 1) * sizeof(*streams))))
+        return E_OUTOFMEMORY;
+    profile->streams = streams;
+    profile->streams[profile->stream_count++] = stream;
+    return S_OK;
+}
+
+static HRESULT wm_read_attributes_start(IXmlReader *reader, BOOL *has_attrs)
+{
+    HRESULT hr = IXmlReader_MoveToFirstAttribute(reader);
+    *has_attrs = (hr == S_OK);
+    return (hr == S_OK || hr == S_FALSE) ? S_OK : hr;
+}
+
+/* Parses attributes of the element the reader currently sits on (works whether that
+ * element is self-closing or not -- attributes are available on the Element node either
+ * way) and dispatches each (local name, value) pair to the caller-supplied handler. */
+typedef void (*attr_cb)(struct parse_ctx *ctx, const WCHAR *name, const WCHAR *value);
+
+static HRESULT wm_walk_attributes(IXmlReader *reader, struct parse_ctx *ctx, attr_cb cb)
+{
+    HRESULT hr;
+    BOOL has_attrs;
+
+    if (FAILED(hr = wm_read_attributes_start(reader, &has_attrs)))
+        return hr;
+
+    while (has_attrs)
+    {
+        const WCHAR *name, *value;
+
+        if (FAILED(hr = IXmlReader_GetLocalName(reader, &name, NULL)))
+            return hr;
+        if (FAILED(hr = IXmlReader_GetValue(reader, &value, NULL)))
+            return hr;
+
+        cb(ctx, name, value);
+
+        hr = IXmlReader_MoveToNextAttribute(reader);
+        if (FAILED(hr))
+            return hr;
+        has_attrs = (hr == S_OK);
+    }
+
+    return S_OK;
+}
+
+static void profile_attr(struct parse_ctx *ctx, const WCHAR *name, const WCHAR *value)
+{
+    struct wm_profile *profile = ctx->profile;
+
+    if (!wcscmp(name, L"version")) profile->version = wm_parse_dword(value);
+    else if (!wcscmp(name, L"storageformat")) profile->storage_format = wm_parse_dword(value);
+    else if (!wcscmp(name, L"name")) profile->name = wm_strdupW(value);
+    else if (!wcscmp(name, L"description")) profile->description = wm_strdupW(value);
+}
+
+static void streamconfig_attr(struct parse_ctx *ctx, const WCHAR *name, const WCHAR *value)
+{
+    struct wm_profile_stream *stream = ctx->cur_stream;
+
+    if (!wcscmp(name, L"majortype"))
+    {
+        GUID guid;
+        if (SUCCEEDED(CLSIDFromString(value, &guid)))
+        {
+            stream->major_type = guid;
+            stream->mt.majortype = guid;
+        }
+    }
+    else if (!wcscmp(name, L"streamnumber")) stream->stream_number = (WORD)wm_parse_dword(value);
+    else if (!wcscmp(name, L"streamname")) stream->stream_name = wm_strdupW(value);
+    else if (!wcscmp(name, L"bitrate")) stream->bitrate = wm_parse_dword(value);
+    else if (!wcscmp(name, L"bufferwindow")) stream->buffer_window = wm_parse_dword(value);
+    /* inputname, reliabletransport, decodercomplexity, rfc1766langid, vbrenabled,
+     * vbrquality, bitratemax, bufferwindowmax: read but intentionally not stored -- out
+     * of scope, see the implementation plan. */
+}
+
+static void wmmediatype_attr(struct parse_ctx *ctx, const WCHAR *name, const WCHAR *value)
+{
+    WM_MEDIA_TYPE *mt = &ctx->cur_stream->mt;
+
+    if (!wcscmp(name, L"subtype"))
+    {
+        GUID guid;
+        if (SUCCEEDED(CLSIDFromString(value, &guid)))
+            mt->subtype = guid;
+    }
+    else if (!wcscmp(name, L"bfixedsizesamples")) mt->bFixedSizeSamples = wm_parse_bool(value);
+    else if (!wcscmp(name, L"btemporalcompression")) mt->bTemporalCompression = wm_parse_bool(value);
+    else if (!wcscmp(name, L"lsamplesize")) mt->lSampleSize = wm_parse_dword(value);
+}
+
+struct wfx_scratch
+{
+    WORD format_tag, channels, block_align, bits_per_sample;
+    DWORD samples_per_sec, avg_bytes_per_sec;
+    BYTE *codec_data;
+    DWORD codec_data_len;
+};
+
+/* Handles the fully self-closing <waveformatex .../> element: collects its attributes and
+ * immediately builds+attaches the WAVEFORMATEX-backed WM_MEDIA_TYPE onto the current stream. */
+static HRESULT handle_waveformatex_element(IXmlReader *reader, struct parse_ctx *ctx)
+{
+    struct wfx_scratch s = {0};
+    WAVEFORMATEX *wfx;
+    HRESULT hr;
+    BOOL has_attrs;
+
+    if (FAILED(hr = wm_read_attributes_start(reader, &has_attrs)))
+        return hr;
+
+    while (has_attrs)
+    {
+        const WCHAR *name, *value;
+
+        if (FAILED(hr = IXmlReader_GetLocalName(reader, &name, NULL)))
+            return hr;
+        if (FAILED(hr = IXmlReader_GetValue(reader, &value, NULL)))
+            return hr;
+
+        if (!wcscmp(name, L"wFormatTag")) s.format_tag = (WORD)wm_parse_dword(value);
+        else if (!wcscmp(name, L"nChannels")) s.channels = (WORD)wm_parse_dword(value);
+        else if (!wcscmp(name, L"nSamplesPerSec")) s.samples_per_sec = wm_parse_dword(value);
+        else if (!wcscmp(name, L"nAvgBytesPerSec")) s.avg_bytes_per_sec = wm_parse_dword(value);
+        else if (!wcscmp(name, L"nBlockAlign")) s.block_align = (WORD)wm_parse_dword(value);
+        else if (!wcscmp(name, L"wBitsPerSample")) s.bits_per_sample = (WORD)wm_parse_dword(value);
+        else if (!wcscmp(name, L"codecdata"))
+        {
+            free(s.codec_data);
+            s.codec_data = wm_decode_hex(value, &s.codec_data_len);
+        }
+
+        hr = IXmlReader_MoveToNextAttribute(reader);
+        if (FAILED(hr)) { free(s.codec_data); return hr; }
+        has_attrs = (hr == S_OK);
+    }
+
+    if (!(wfx = CoTaskMemAlloc(sizeof(*wfx) + s.codec_data_len)))
+    {
+        free(s.codec_data);
+        return E_OUTOFMEMORY;
+    }
+    wfx->wFormatTag = s.format_tag;
+    wfx->nChannels = s.channels;
+    wfx->nSamplesPerSec = s.samples_per_sec;
+    wfx->nAvgBytesPerSec = s.avg_bytes_per_sec;
+    wfx->nBlockAlign = s.block_align;
+    wfx->wBitsPerSample = s.bits_per_sample;
+    wfx->cbSize = (WORD)s.codec_data_len;
+    if (s.codec_data_len)
+        memcpy(wfx + 1, s.codec_data, s.codec_data_len);
+    free(s.codec_data);
+
+    CoTaskMemFree(ctx->cur_stream->mt.pbFormat);
+    ctx->cur_stream->mt.formattype = wm_FORMAT_WaveFormatEx;
+    ctx->cur_stream->mt.cbFormat = sizeof(*wfx) + s.codec_data_len;
+    ctx->cur_stream->mt.pbFormat = (BYTE *)wfx;
+    return S_OK;
+}
+
+static HRESULT handle_rcsource_element(IXmlReader *reader, struct parse_ctx *ctx, RECT *rc)
+{
+    HRESULT hr;
+    BOOL has_attrs;
+
+    memset(rc, 0, sizeof(*rc));
+    if (FAILED(hr = wm_read_attributes_start(reader, &has_attrs)))
+        return hr;
+
+    while (has_attrs)
+    {
+        const WCHAR *name, *value;
+
+        if (FAILED(hr = IXmlReader_GetLocalName(reader, &name, NULL)))
+            return hr;
+        if (FAILED(hr = IXmlReader_GetValue(reader, &value, NULL)))
+            return hr;
+
+        if (!wcscmp(name, L"left")) rc->left = wm_parse_dword(value);
+        else if (!wcscmp(name, L"top")) rc->top = wm_parse_dword(value);
+        else if (!wcscmp(name, L"right")) rc->right = wm_parse_dword(value);
+        else if (!wcscmp(name, L"bottom")) rc->bottom = wm_parse_dword(value);
+
+        hr = IXmlReader_MoveToNextAttribute(reader);
+        if (FAILED(hr)) return hr;
+        has_attrs = (hr == S_OK);
+    }
+    return S_OK;
+}
+
+static HRESULT handle_bitmapinfoheader_element(IXmlReader *reader, BITMAPINFOHEADER *bmih)
+{
+    HRESULT hr;
+    BOOL has_attrs;
+
+    memset(bmih, 0, sizeof(*bmih));
+    bmih->biSize = sizeof(*bmih);
+    if (FAILED(hr = wm_read_attributes_start(reader, &has_attrs)))
+        return hr;
+
+    while (has_attrs)
+    {
+        const WCHAR *name, *value;
+
+        if (FAILED(hr = IXmlReader_GetLocalName(reader, &name, NULL)))
+            return hr;
+        if (FAILED(hr = IXmlReader_GetValue(reader, &value, NULL)))
+            return hr;
+
+        if (!wcscmp(name, L"biwidth")) bmih->biWidth = wm_parse_dword(value);
+        else if (!wcscmp(name, L"biheight")) bmih->biHeight = wm_parse_dword(value);
+        else if (!wcscmp(name, L"biplanes")) bmih->biPlanes = (WORD)wm_parse_dword(value);
+        else if (!wcscmp(name, L"bibitcount")) bmih->biBitCount = (WORD)wm_parse_dword(value);
+        else if (!wcscmp(name, L"bicompression")) bmih->biCompression = wm_fourcc_from_string(value);
+        else if (!wcscmp(name, L"bisizeimage")) bmih->biSizeImage = wm_parse_dword(value);
+        else if (!wcscmp(name, L"bixpelspermeter")) bmih->biXPelsPerMeter = wm_parse_dword(value);
+        else if (!wcscmp(name, L"biypelspermeter")) bmih->biYPelsPerMeter = wm_parse_dword(value);
+        else if (!wcscmp(name, L"biclrused")) bmih->biClrUsed = wm_parse_dword(value);
+        else if (!wcscmp(name, L"biclrimportant")) bmih->biClrImportant = wm_parse_dword(value);
+
+        hr = IXmlReader_MoveToNextAttribute(reader);
+        if (FAILED(hr)) return hr;
+        has_attrs = (hr == S_OK);
+    }
+    return S_OK;
+}
+
+static HRESULT handle_videoinfoheader_start(IXmlReader *reader, struct parse_ctx *ctx)
+{
+    HRESULT hr;
+    BOOL has_attrs;
+
+    ctx->vih_bitrate = ctx->vih_biterrorrate = 0;
+    ctx->vih_avgtimeperframe = 0;
+    memset(&ctx->rc_source, 0, sizeof(ctx->rc_source));
+    memset(&ctx->rc_target, 0, sizeof(ctx->rc_target));
+    memset(&ctx->bmih, 0, sizeof(ctx->bmih));
+
+    if (FAILED(hr = wm_read_attributes_start(reader, &has_attrs)))
+        return hr;
+
+    while (has_attrs)
+    {
+        const WCHAR *name, *value;
+
+        if (FAILED(hr = IXmlReader_GetLocalName(reader, &name, NULL)))
+            return hr;
+        if (FAILED(hr = IXmlReader_GetValue(reader, &value, NULL)))
+            return hr;
+
+        if (!wcscmp(name, L"dwbitrate")) ctx->vih_bitrate = wm_parse_dword(value);
+        else if (!wcscmp(name, L"dwbiterrorrate")) ctx->vih_biterrorrate = wm_parse_dword(value);
+        else if (!wcscmp(name, L"avgtimeperframe")) ctx->vih_avgtimeperframe = wm_parse_qword(value);
+
+        hr = IXmlReader_MoveToNextAttribute(reader);
+        if (FAILED(hr)) return hr;
+        has_attrs = (hr == S_OK);
+    }
+    return S_OK;
+}
+
+static HRESULT handle_videoinfoheader_end(struct parse_ctx *ctx)
+{
+    VIDEOINFOHEADER *vih;
+
+    if (!(vih = CoTaskMemAlloc(sizeof(*vih))))
+        return E_OUTOFMEMORY;
+
+    vih->rcSource = ctx->rc_source;
+    vih->rcTarget = ctx->rc_target;
+    vih->dwBitRate = ctx->vih_bitrate;
+    vih->dwBitErrorRate = ctx->vih_biterrorrate;
+    vih->AvgTimePerFrame = ctx->vih_avgtimeperframe;
+    vih->bmiHeader = ctx->bmih;
+
+    CoTaskMemFree(ctx->cur_stream->mt.pbFormat);
+    ctx->cur_stream->mt.formattype = wm_FORMAT_VideoInfo;
+    ctx->cur_stream->mt.cbFormat = sizeof(*vih);
+    ctx->cur_stream->mt.pbFormat = (BYTE *)vih;
+    return S_OK;
+}
+
+static HRESULT handle_element_start(IXmlReader *reader, struct parse_ctx *ctx,
+        enum profile_ctx parent, const WCHAR *name, enum profile_ctx *child_out)
+{
+    HRESULT hr = S_OK;
+
+    if (!wcscmp(name, L"profile"))
+    {
+        *child_out = CTX_PROFILE;
+        hr = wm_walk_attributes(reader, ctx, profile_attr);
+    }
+    else if (!wcscmp(name, L"streamconfig"))
+    {
+        struct wm_profile_stream *stream;
+
+        *child_out = CTX_STREAMCONFIG;
+        if (FAILED(hr = wm_profile_stream_create(&stream)))
+            return hr;
+        ctx->cur_stream = stream;
+        hr = wm_walk_attributes(reader, ctx, streamconfig_attr);
+    }
+    else if (!wcscmp(name, L"wmmediatype"))
+    {
+        *child_out = CTX_WMMEDIATYPE;
+        hr = wm_walk_attributes(reader, ctx, wmmediatype_attr);
+    }
+    else if (!wcscmp(name, L"waveformatex"))
+    {
+        *child_out = CTX_OTHER;
+        hr = handle_waveformatex_element(reader, ctx);
+    }
+    else if (!wcscmp(name, L"videoinfoheader"))
+    {
+        *child_out = CTX_VIDEOINFOHEADER;
+        hr = handle_videoinfoheader_start(reader, ctx);
+    }
+    else if (!wcscmp(name, L"rcsource"))
+    {
+        *child_out = CTX_OTHER;
+        hr = handle_rcsource_element(reader, ctx, &ctx->rc_source);
+    }
+    else if (!wcscmp(name, L"rctarget"))
+    {
+        *child_out = CTX_OTHER;
+        hr = handle_rcsource_element(reader, ctx, &ctx->rc_target);
+    }
+    else if (!wcscmp(name, L"bitmapinfoheader"))
+    {
+        *child_out = CTX_OTHER;
+        hr = handle_bitmapinfoheader_element(reader, &ctx->bmih);
+    }
+    else
+    {
+        /* videomediaprops, dataunitextension, streamprioritization, stream, and any
+         * unrecognized element: no data needed, just keep the context stack balanced. */
+        *child_out = CTX_OTHER;
+    }
+
+    (void)parent;
+    return hr;
+}
+
+static HRESULT handle_element_end(struct parse_ctx *ctx, enum profile_ctx closing)
+{
+    if (closing == CTX_STREAMCONFIG)
+    {
+        struct wm_profile_stream *stream = ctx->cur_stream;
+        HRESULT hr;
+
+        ctx->cur_stream = NULL;
+        if (!stream)
+            return S_OK;
+        if (FAILED(hr = wm_profile_add_stream(ctx->profile, stream)))
+        {
+            wm_profile_stream_destroy(stream);
+            return hr;
+        }
+    }
+    else if (closing == CTX_VIDEOINFOHEADER)
+    {
+        return handle_videoinfoheader_end(ctx);
+    }
+
+    return S_OK;
+}
+
+static HRESULT parse_profile_xml(IXmlReader *reader, struct parse_ctx *ctx)
+{
+    XmlNodeType type;
+    HRESULT hr;
+
+    ctx->stack[0] = CTX_ROOT;
+    ctx->depth = 0;
+
+    while ((hr = IXmlReader_Read(reader, &type)) == S_OK)
+    {
+        if (type == XmlNodeType_Element)
+        {
+            const WCHAR *name;
+            enum profile_ctx parent = ctx->stack[ctx->depth];
+            enum profile_ctx child = CTX_OTHER;
+            BOOL is_empty = IXmlReader_IsEmptyElement(reader);
+
+            if (FAILED(hr = IXmlReader_GetLocalName(reader, &name, NULL)))
+                return hr;
+
+            if (FAILED(hr = handle_element_start(reader, ctx, parent, name, &child)))
+                return hr;
+
+            if (is_empty)
+            {
+                /* No matching EndElement follows for a self-closing element in this
+                 * reader -- all its work already happened in handle_element_start(). */
+                continue;
+            }
+
+            if (ctx->depth + 1 >= (int)(sizeof(ctx->stack) / sizeof(ctx->stack[0])))
+                return NS_E_INVALID_DATA;
+            ctx->stack[++ctx->depth] = child;
+        }
+        else if (type == XmlNodeType_EndElement)
+        {
+            enum profile_ctx closing = ctx->depth ? ctx->stack[ctx->depth] : CTX_ROOT;
+
+            if (FAILED(hr = handle_element_end(ctx, closing)))
+                return hr;
+
+            if (ctx->depth > 0)
+                ctx->depth--;
+
+            if (closing == CTX_PROFILE)
+                return S_OK;
+        }
+    }
+
+    return FAILED(hr) ? hr : NS_E_INVALID_DATA;
+}
+
+HRESULT wm_profile_create_from_xml(const WCHAR *data, void **out_ptr)
+{
+    IWMProfile **out = (IWMProfile **)out_ptr;
+    struct wm_profile *profile;
+    IXmlReader *reader = NULL;
+    IStream *stream = NULL;
+    HGLOBAL hmem;
+    void *buf;
+    HRESULT hr;
+    struct parse_ctx ctx;
+    size_t byte_len;
+
+    *out = NULL;
+    if (!data)
+        return E_INVALIDARG;
+
+    byte_len = (wcslen(data) + 1) * sizeof(WCHAR);
+    if (!(hmem = GlobalAlloc(0, byte_len)))
+        return E_OUTOFMEMORY;
+    if (!(buf = GlobalLock(hmem)))
+    {
+        GlobalFree(hmem);
+        return E_OUTOFMEMORY;
+    }
+    memcpy(buf, data, byte_len);
+    GlobalUnlock(hmem);
+
+    if (FAILED(hr = CreateStreamOnHGlobal(hmem, TRUE, &stream)))
+    {
+        GlobalFree(hmem);
+        return hr;
+    }
+
+    if (FAILED(hr = CreateXmlReader(&IID_IXmlReader, (void **)&reader, NULL)))
+    {
+        IStream_Release(stream);
+        return hr;
+    }
+
+    if (FAILED(hr = IXmlReader_SetInput(reader, (IUnknown *)stream)))
+        goto done;
+
+    if (!(profile = calloc(1, sizeof(*profile))))
+    {
+        hr = E_OUTOFMEMORY;
+        goto done;
+    }
+    profile->IWMProfile3_iface.lpVtbl = &profile_vtbl;
+    profile->refcount = 1;
+
+    memset(&ctx, 0, sizeof(ctx));
+    ctx.profile = profile;
+
+    if (FAILED(hr = parse_profile_xml(reader, &ctx)))
+    {
+        if (ctx.cur_stream)
+            wm_profile_stream_destroy(ctx.cur_stream);
+        wm_profile_destroy(profile);
+        goto done;
+    }
+
+    *out = (IWMProfile *)&profile->IWMProfile3_iface;
+    hr = S_OK;
+
+done:
+    if (reader) IXmlReader_Release(reader);
+    IStream_Release(stream);
+    return hr;
+}
