-    FIXME("(%p)->(%s %p)\n", This, debugstr_w(profile), ret);
-    return E_NOTIMPL;
+    TRACE("(%p)->(%s %p)\n", This, debugstr_w(profile), ret);
+    return wm_profile_create_from_xml(profile, (void **)ret);
 }
 
