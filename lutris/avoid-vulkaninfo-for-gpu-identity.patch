+@cache_single
+def get_vulkan_devices():
+    """Return Vulkan identity data, querying all physical devices only once."""
+    output = system.read_process_output(
+        [VULKAN_DEVICE_INFO_HELPER], env=os.environ, error_result=""
+    )
+    if not output:
+        return []
+    try:
+        devices = json.loads(output)
+    except json.JSONDecodeError as error:
+        logger.error("Unable to parse Vulkan device information: %s", error)
+        return []
+    if not isinstance(devices, list):
+        logger.error("Vulkan device information is not a list")
+        return []
+    return devices
+
